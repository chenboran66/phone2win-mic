<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="状态: 未启动"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#444444" />

            <TextView
                android:id="@+id/tv_pc_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="目标电脑: 未连接"
                android:textSize="13sp"
                android:textColor="#555555" />

            <TextView
                android:id="@+id/tv_abi_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="架构引擎: 检测中..."
                android:textSize="12sp"
                android:textColor="#777777" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="麦克风实时电平"
                android:textSize="12sp"
                android:textColor="#666666" />

            <ProgressBar
                android:id="@+id/pb_level"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_toggle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="开始传输"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_rediscover"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="重搜电脑" />
            </LinearLayout>
        </LinearLayout>

        <!-- Network Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="网络连接设置"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <CheckBox
                android:id="@+id/cb_auto_discover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="自动发现局域网 Windows 电脑 (推荐，免填 IP)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_pc_ip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="手动电脑 IP (如 192.168.1.100)"
                    android:inputType="text"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/et_port"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="端口"
                    android:inputType="number"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Audio Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音频采集与处理 (修改采样率/音频源需重开传输)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="采样率"
                android:textSize="12sp"
                android:textColor="#666666" />

            <Spinner
                android:id="@+id/sp_sample_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="麦克风音频源"
                android:textSize="12sp"
                android:textColor="#666666" />

            <Spinner
                android:id="@+id/sp_audio_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="实时增益 (含防破音软限幅)"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_gain_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_gain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="250"
                android:progress="50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="实时噪声门限 (抑制底噪/风扇声)"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_gate_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_gate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />

            <CheckBox
                android:id="@+id/cb_hw_ns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="启用手机系统硬件降噪 (NoiseSuppressor)" />

            <CheckBox
                android:id="@+id/cb_hw_agc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用手机系统自动增益 (AGC)" />
        </LinearLayout>

        <!-- Automation & Background Keep-Alive Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="全自动化与关屏保活"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <CheckBox
                android:id="@+id/cb_auto_boot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="手机开机自动进入后台传音服务" />

            <Button
                android:id="@+id/btn_battery_opt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="关闭电池优化 (推荐：防关屏断流)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="提示：小米/华为/OPPO/vivo 等系统若需长期熄屏或开机自启，建议同时在系统“应用管理”中勾选“自启动”并锁定后台卡片。"
                android:textSize="12sp"
                android:textColor="#777777" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
